---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="你访问的页面不存在">
  <section class="container not-found">
    <h1>404</h1>
    <p class="muted">你访问的页面不存在。</p>
    <p><a class="btn" href="/">返回首页</a></p>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding: 96px 24px;
    text-align: center;
  }

  .not-found h1 {
    font-size: 3rem;
  }
</style>
