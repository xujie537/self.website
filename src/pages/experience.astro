---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// order 数字越大排越前
const experiences = (await getCollection('experience')).sort(
  (a, b) => b.data.order - a.data.order,
);
---

<BaseLayout title="经历" description="我的工作与项目经历">
  <section class="container page-head">
    <h1>经历</h1>
    <p class="muted">我的工作与项目经历</p>
  </section>

  <section class="container timeline">
    {
      experiences.length === 0 ? (
        <div class="card timeline-empty">经历整理中，敬请期待。</div>
      ) : (
        experiences.map((exp) => (
          <article class="card timeline-item">
            <div class="timeline-top">
              <span class="period">{exp.data.period}</span>
              {exp.data.current && <span class="tag">进行中</span>}
            </div>
            <h2 class="timeline-role">{exp.data.role}</h2>
            <p class="timeline-company">
              {exp.data.company}
              {exp.data.location && <span class="muted"> · {exp.data.location}</span>}
            </p>
            {exp.data.summary && <p class="timeline-summary">{exp.data.summary}</p>}
            {
              exp.data.highlights.length > 0 && (
                <ul class="timeline-highlights">
                  {exp.data.highlights.map((item) => <li>{item}</li>)}
                </ul>
              )
            }
            {
              exp.data.details.length > 0 && (
                <details class="timeline-details">
                  <summary>查看详细工作内容</summary>
                  {
                    exp.data.details.map((group) => (
                      <div class="detail-group">
                        <h3>{group.title}</h3>
                        <ul>
                          {group.items.map((item) => <li>{item}</li>)}
                        </ul>
                      </div>
                    ))
                  }
                </details>
              )
            }
          </article>
        ))
      )
    }
  </section>
</BaseLayout>

<style>
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-bottom: 40px;
    margin-left: 20px;
    border-left: 2px solid var(--color-border);
    padding-left: 20px;
  }

  .timeline-item {
    position: relative;
  }

  /* 左侧时间轴圆点 */
  .timeline-item::before {
    content: "";
    position: absolute;
    left: -27px;
    top: 38px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 4px var(--color-accent-soft);
  }

  .timeline-top {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .period {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .timeline-role {
    margin: 8px 0 4px;
  }

  .timeline-company {
    margin-bottom: 12px;
  }

  .timeline-highlights {
    margin-bottom: 0;
  }

  .timeline-empty {
    text-align: center;
    color: var(--color-muted);
  }

  .timeline-summary {
    margin-bottom: 12px;
  }

  /* 点击展开的详情区（原生 details/summary，无需 JS） */
  .timeline-details {
    margin-top: 16px;
    border-top: 1px dashed var(--color-border);
    padding-top: 12px;
  }

  .timeline-details summary {
    cursor: pointer;
    color: var(--color-accent);
    font-weight: 500;
    list-style: none;
    user-select: none;
  }

  .timeline-details summary::-webkit-details-marker {
    display: none;
  }

  .timeline-details summary::after {
    content: "▾";
    display: inline-block;
    margin-left: 6px;
    transition: transform 0.2s;
  }

  .timeline-details[open] summary::after {
    transform: rotate(180deg);
  }

  .detail-group {
    margin-top: 14px;
  }

  .detail-group h3 {
    font-size: 1rem;
    margin-bottom: 4px;
  }

  .detail-group ul {
    margin-bottom: 0;
  }
</style>
