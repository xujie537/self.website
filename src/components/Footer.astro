---
import type { CollectionEntry } from 'astro:content';

interface Props {
  siteInfo: CollectionEntry<'site'>['data'];
}

const { siteInfo } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p>© {year} {siteInfo.name}</p>
    <div class="footer-links">
      {
        siteInfo.github && (
          <a href={siteInfo.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        )
      }
      <a href="/contact/">联系我</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 64px;
    border-top: 1px solid var(--color-border);
    padding: 20px 0;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.9rem;
    color: var(--color-muted);
  }

  .footer-inner p {
    margin: 0;
  }

  .footer-links {
    display: flex;
    gap: 16px;
  }
</style>
